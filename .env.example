# =====================================================================================
# Copie este archivo como .env (en la misma carpeta) y complete los valores.
# El .env NO se sube a GitHub (esta en .gitignore). Este .env.example si, pero sin secretos.
# Formato: NOMBRE=valor   (sin espacios alrededor del =; comillas opcionales)
# Cualquier variable tambien se puede pasar con -DNOMBRE=valor al ejecutar.
# =====================================================================================

# ---------- Credenciales AWS ----------
# Use credenciales temporales (las de "Command line or programmatic access" del portal SSO).
# Vencen en unas horas: cuando venzan, pegue unas nuevas aqui.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# ---------- S3 donde queda el RESDWI.TXT ----------
RESDWI_S3_BUCKET=
# Ruta dentro del bucket. Admite ${FECHA} (yyyyMMdd), ej: salidas/ods/RESDWI_${FECHA}.TXT
RESDWI_S3_KEY=
# Solo si se usa un endpoint de VPC u otro distinto al publico de S3
# RESDWI_S3_ENDPOINT=https://bucket.vpce-xxxx.s3.us-east-1.vpce.amazonaws.com

# ---------- Auditoria ----------
# Transacciones inyectadas que deben aparecer en el RESDWI
RESDWI_ESPERADAS=80
# Ruta local de un RESDWI.TXT (para RunnerAmbienteArchivoLocal)
# RESDWI_ARCHIVO=C:/Users/usuario/Downloads/RESDWI.TXT

# ---------- Curl ----------
# Variables que usan los curl de src/test/resources/curl como ${NOMBRE}
BASE_URL=
API_KEY=
# Cuantas veces enviar el curl de inyeccion y pausa entre envios
CURL_REPETICIONES=80
CURL_PAUSA_MS=200
CURL_TIMEOUT_SEGUNDOS=60
# Proxy corporativo, si hace falta (host:puerto)
# CURL_PROXY=proxy.banco.com:8080
